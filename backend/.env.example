# Supabase credentials for Render deployment
# Replace the placeholder values with your actual Supabase project details

SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# The DATABASE_URL is typically required by hosting platforms like Render
# You can get this from your Supabase project's database settings
DATABASE_URL=postgresql://user:password@host:port/dbname
